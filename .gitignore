# Secrets & comptes — jamais commités
data/admin.json
.env
*.env

# Les photos publiees FONT PARTIE du site : elles doivent etre versionnees.
# Les exclure les rendait absentes d un hebergement statique, ou rien ne les
# reconstruit — c est ce qui provoquait les erreurs 404 en ligne.
#
# Les originaux, eux, ne sont jamais servis : ils restent hors du depot.
storage/originals/*
!storage/originals/.gitkeep

# Divers
Thumbs.db
.DS_Store

# Fichiers de l ancien site Talinjoo (autre hotel, autre ville), deplaces
# hors du site le 19/09/2026. Conserves sur disque, hors versionnement.
# Recuperables aussi depuis le commit initial (git show 9eef186).
_archive_ancien_site/

# Dossier prepare pour la mise en ligne (regenere par tools/package.php)
livraison/

# Journal des erreurs PHP (genere a l execution)
data/erreurs.log

# Secrets hors depot : mot de passe SMTP.
# Ce depot est public — rien de confidentiel ne doit y entrer.
config/site.local.php

# Journaux et compteurs generes a l execution
data/emails-test.log
data/envois.json
data/media.generated.json
